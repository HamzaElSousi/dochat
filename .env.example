# Copy to .env and fill in real values. Never commit .env.
OPENROUTER_API_KEY=your_openrouter_api_key_here
ADMIN_PASSWORD=change_me
SECRET_KEY=change_me_generate_with_python_secrets

# MySQL archival (Phase 3 cron -- scripts/archive_sessions.py):
# SQLAlchemy-style connection URL for the separate MySQL database.
# Provisioned via cPanel -> MySQL Databases (NOT the existing site DB).
MYSQL_URL=mysql+mysqlconnector://user:pass@host/dbname

# ── Phase 3: Query Pipeline ──────────────────────────────────────────────────

# CORS: comma-separated list of allowed origins for POST /chat.
# Widget origin must be listed or the browser will block the response.
# Example: https://social-automate.com,https://www.social-automate.com
ALLOWED_ORIGINS=

# Fallback message returned when no relevant chunks found (similarity gate, D-09/D-10).
# Default shown; override per deployment.
FALLBACK_MESSAGE=I don't have information on that yet. Feel free to ask something else.

# Cosine similarity threshold for the similarity gate (D-11).
# Lower = more permissive (more LLM calls). Higher = stricter (more fallbacks).
# Default: 0.35. Do not set below 0.1 or above 0.9.
SIMILARITY_THRESHOLD=0.35

# Chat assistant branding (D-15).
ASSISTANT_NAME=DocChat Assistant
ASSISTANT_PERSONA=a helpful AI assistant

# .htaccess deployment note (manual step — not a Flask env var):
# Add this RewriteRule to ~/www/staging.social-automate.com/public_html/.htaccess
# in the block that routes API calls to app.cgi:
#
#   RewriteRule ^chat/?$ /app.cgi/chat [QSA,L]
#
# This must be added alongside the existing /health and /admin/* rules.
