# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ── Core ─────────────────────────────────────────────────────────────────────

# Flask session secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_with_python_secrets

# Password for /dochat/admin (HTTP Basic Auth). Username is ignored — only password is checked.
ADMIN_PASSWORD=change_me

# ── Storage ───────────────────────────────────────────────────────────────────

# Absolute path to the directory for dochat.db and uploaded files.
# Must be OUTSIDE public_html/ so it is not web-accessible.
# On SiteGround: /home/customer/dochat/storage
# Local dev:     leave unset (defaults to ./storage/ relative to repo root)
STORAGE_PATH=

# ── LLM provider ──────────────────────────────────────────────────────────────
# DocChat talks to any OpenAI-compatible endpoint.
#   openrouter (default) = hosted, for production. Needs OPENROUTER_API_KEY.
#   ollama               = fully local, no API key. Run "ollama serve" first.
# LLM_PROVIDER sets the chat model; EMBED_PROVIDER defaults to LLM_PROVIDER.
LLM_PROVIDER=openrouter
# EMBED_PROVIDER=ollama   # uncomment to mix (e.g. local embeddings, hosted chat)

# OpenRouter API key (only needed when a provider above is openrouter).
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama server (used when a provider is "ollama").
OLLAMA_BASE_URL=http://localhost:11434

# Chat models. PRIMARY_MODEL is tried first; FALLBACK_MODEL is used on 429 / error.
# Leave unset to use sensible per-provider defaults.
#   openrouter example: google/gemma-3-27b-it:free
#   ollama example:     llama3   (or gemma4:e4b, mistral, ...)
PRIMARY_MODEL=google/gemma-3-27b-it:free
FALLBACK_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Embeddings. Model + dimension follow the provider unless overridden here.
#   openrouter default: openai/text-embedding-3-small (1536 dims)
#   ollama default:     nomic-embed-text              (768 dims)
# The DB must be re-ingested if the embedding dimension changes.
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for POST /dochat/api/chat and the
# public widget endpoints (/dochat/api/leads, /dochat/api/settings).
# The widget origin MUST be listed or the browser will block responses.
# Example: https://social-automate.com,https://www.social-automate.com
ALLOWED_ORIGINS=

# ── Chat behaviour ────────────────────────────────────────────────────────────

# Fallback message returned when no document chunk meets the similarity threshold.
FALLBACK_MESSAGE=I don't have information on that yet. Feel free to ask something else.

# Cosine similarity threshold for the RAG gate (0.0–1.0).
# Lower = more permissive (more LLM calls). Higher = stricter (more fallbacks → lead forms).
# Default 0.35 works well for most document sets. Do not set below 0.1 or above 0.9.
SIMILARITY_THRESHOLD=0.35

# Branding used in the LLM system prompt.
ASSISTANT_NAME=DocChat Assistant
ASSISTANT_PERSONA=a helpful AI assistant

# ── SMTP (lead capture email notifications) ───────────────────────────────────
#
# When a visitor submits the lead form, DocChat sends a plain-text email to
# ADMIN_EMAIL. Email failure is NON-FATAL — the lead is always saved to SQLite
# regardless of whether the email succeeds.
#
# On SiteGround: use your cPanel email account credentials.
#   SMTP_HOST  →  mail.your-domain.com  (find in cPanel → Email Accounts → Connect Devices)
#   SMTP_PORT  →  465 (SSL) or 587 (STARTTLS) — SiteGround supports both
#   SMTP_USER  →  the full email address (e.g. noreply@social-automate.com)
#   SMTP_PASS  →  the email account password (NOT your cPanel password)
#   ADMIN_EMAIL → where lead notifications are delivered (can be the same as SMTP_USER)
#
# Leave all blank to disable email notifications entirely (leads still saved to DB).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# ── MySQL session archival (optional) ─────────────────────────────────────────
#
# scripts/archive_sessions.py moves SQLite sessions older than 24 h to MySQL.
# Only needed if you want long-term conversation analytics.
# Provision the database via cPanel → MySQL Databases.
# Format: mysql+mysqlconnector://user:pass@host/dbname
MYSQL_URL=
